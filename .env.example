# Разбор описаний: rules — без модели, openai — любая модель с OpenAI-совместимым API в контуре
DFA_LLM_PROVIDER=rules

# vLLM или Ollama с открытой моделью
# DFA_LLM_PROVIDER=openai
# DFA_LLM_BASE_URL=http://vllm:8000/v1
# DFA_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# DFA_LLM_LABEL=Qwen 2.5 в контуре (vLLM)

# GigaChat через прокси gpt2giga
# DFA_LLM_PROVIDER=openai
# DFA_LLM_BASE_URL=http://gpt2giga:8090/v1
# DFA_LLM_MODEL=GigaChat-2-Max
# DFA_LLM_LABEL=GigaChat

# Реквизиты оператора информационной системы для решения о выпуске
DFA_OPERATOR_NAME=ООО «Оператор ИС»
DFA_OPERATOR_OGRN=0000000000010
DFA_OPERATOR_WEBSITE=https://operator.example
